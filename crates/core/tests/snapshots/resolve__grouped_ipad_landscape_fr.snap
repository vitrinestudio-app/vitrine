expression: snapshot_value(&s)
---
backgrounds:
  - angle: 160
    kind: linear-gradient
    stops:
      - color: "#EAF4E4"
        pos: 0
      - color: "#B7D9A6"
        pos: 1
diagnostics:
  - code: partial_image
    level: info
    message: "5 pages with `group: 2`: the last image has 1 empty column(s)"
  - code: screenshot_fallback
    element: hero-phone
    level: info
    message: "`fr` uses fallback screenshot `screenshots/en/ios-tablet/home.jpg` for `home`"
  - code: text_fallback
    element: title-1
    level: info
    message: "text `hero.title` for `fr` uses `en`"
