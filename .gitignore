# Rust build output
/target/

# Generated by tauri-build (capability/ACL schemas)
/crates/gui/gen/
# Release bundling inputs (scripts/release/, ADR 0026): the CLI sidecar
# (`binaries/vitrine-<target>`) and the licence files bundled as resources.
/crates/gui/binaries/
/crates/gui/bundle/

# Vitrine Studio project folders: render output and caches (docs/KONZEPT.md 3.1).
# Anchored to directories named exactly `export` / `.cache`, at any depth.
**/export/
**/.cache/
# ...but never Rust source modules that happen to be called `export`.
!/crates/**/src/**/export/

# Golden-image test failures (actual/diff images written next to references)
*.actual.png
*.diff.png

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo
.fleet/
.zed/

# Claude Code agent worktrees
/.claude/worktrees/

# Vendor device frames (Apple Design Resources etc.) must never be committed:
# Vitrine Studio imports them app-wide only (KONZEPT §4.2, ADR 0012). Guards against
# a frame store, a downloaded package or an extracted bezel landing here.
**/frames/apple/
*.dmg
**/Bezel-*/
**/*Product Bezels*/
# Project copies of imported vendor frames ("Store used device frames in the
# project", ADR 0027) are for private project repositories, never this one.
**/frames/imported/
